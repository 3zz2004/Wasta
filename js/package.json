{
  "name": "wasta",
  "version": "0.1.0",
  "description": "The Egyptian utilities every app ends up rewriting: phone numbers, national IDs, tafqeet, governorates and Arabic text normalization.",
  "keywords": [
    "egypt",
    "egyptian",
    "arabic",
    "tafqeet",
    "national-id",
    "phone",
    "governorates",
    "normalization",
    "مصر"
  ],
  "author": "Ezz Eldeen Mohamed Hassan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3zz2004/Wasta.git",
    "directory": "js"
  },
  "homepage": "https://github.com/3zz2004/Wasta#readme",
  "bugs": "https://github.com/3zz2004/Wasta/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../scripts/copy-docs.mjs && npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "smoke": "node smoke/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
